<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../UIElementsSchema/UIElements.xsd" authoring-id="722755129" editor-extension-mode="False">
    <Style src="project://database/Assets/UIStyles/GENialStyle.uss?fileID=7433441132597879392&amp;guid=43c53e55ba41bb845addab7a50c7633b&amp;type=3#GENialStyle"/>
    <ui:VisualElement name="Root" style="flex-grow: 1; flex-direction: row;">
        <ui:VisualElement name="ActionsPanel" class="panel" style="flex-grow: 1; flex-shrink: 1; margin-right: 2px; align-items: center; justify-content: center;">
            <ui:Label text="GENial" name="Title" class="label" style="-unity-text-align: upper-center; height: 69px; white-space: pre; position: absolute; bottom: auto; top: 20%; font-size: 75px; width: 258px; flex-direction: column; justify-content: space-between; align-items: center; align-self: center; color: rgb(255, 255, 255);">
                <ui:Label text="Rhythm is just&#10;a *gene* away!" name="Subtitle" style="height: 68px; top: 100%; width: 168px; font-size: 36.5px; color: rgb(171, 171, 171);"/>
            </ui:Label>
            <ui:Button text="Play" name="PlayButton" class="button" style="height: 50px; width: 350px; font-size: 20px; margin-bottom: 10px; background-color: rgb(0, 185, 69); color: rgb(255, 255, 255); border-top-left-radius: 4px; position: relative;"/>
            <ui:Button text="Exit" name="ExitButton" class="button" style="height: 50px; width: 350px; font-size: 20px; margin-top: 10px; position: relative;"/>
        </ui:VisualElement>
        <ui:VisualElement name="SettingsPanel" class="panel" style="flex-grow: 1; flex-shrink: 1; margin-right: 2px; margin-left: 2px; justify-content: center; align-items: center;">
            <ui:Label text="Settings" name="Title" class="label" style="-unity-text-align: upper-center; height: 69px; white-space: pre; position: absolute; bottom: auto; top: 20%; font-size: 75px; width: 313px; flex-direction: column; justify-content: space-between; align-items: center; align-self: center; color: rgb(255, 255, 255);">
                <ui:Label text="For your custom song!" name="Subtitle" style="height: 68px; top: 100%; width: 168px; font-size: 36.5px; color: rgb(171, 171, 171);"/>
            </ui:Label>
            <ui:FloatField label="BPM" value="124" password="false" name="BPMField" class="numberbox inputfield" style="width: 510px;"/>
            <ui:FloatField label="Delay" value="0" password="false" name="DelayField" class="numberbox inputfield" style="width: 510px;"/>
            <ui:Button text="Load song from file" name="OpenSongButton" class="button" style="height: auto; width: 510px; font-size: 20px; margin-top: 10px; position: relative;"/>
            <ui:Label text="WARNING: songs with variable bitrate NOT supported" name="WarningLabel" class="label" style="width: 504px; -unity-text-align: upper-center; color: rgba(171, 171, 171, 0.298);"/>
            <ui:Label text="" name="ErrorLabel" class="label" style="width: 504px; -unity-text-align: upper-center; color: rgba(171, 171, 171, 0.298); bottom: 0%; position: absolute;">
                <Bindings>
                    <ui:DataBinding property="text" data-source="project://database/Assets/Bindings/LoadSongErrorMessageBinding.asset?fileID=11400000&amp;guid=bdd159831aaee1b4d9fbe9ee74f30957&amp;type=2#LoadSongErrorMessageBinding" binding-mode="ToTarget" data-source-path="Message"/>
                </Bindings>
            </ui:Label>
        </ui:VisualElement>
        <ui:VisualElement name="SongsPanel" class="panel" style="flex-grow: 1; flex-shrink: 1; margin-left: 2px; justify-content: center; align-items: center;">
            <ui:Label text="Presets" name="Title" class="label" style="-unity-text-align: upper-center; height: 69px; white-space: pre; position: absolute; bottom: auto; top: 20%; font-size: 75px; width: 286px; flex-direction: column; justify-content: space-between; align-items: center; align-self: center; color: rgb(255, 255, 255);">
                <ui:Label text="Default uncopyright songs&#10;by Kevin MacLeod!" name="Subtitle" style="height: 68px; top: 100%; width: 168px; font-size: 36.5px; color: rgb(171, 171, 171);"/>
            </ui:Label>
            <ui:Button text="Mesmerizing Galaxy (easy)" name="MesmerizingGalaxyButton" class="button" style="height: auto; width: 510px; font-size: 20px; margin-top: 10px; position: relative; background-color: rgb(25, 36, 177); color: rgb(255, 255, 255);"/>
            <ui:Button text="Galactic Rap (easy)" name="GalacticRapButton" class="button" style="height: auto; width: 510px; font-size: 20px; margin-top: 10px; position: relative; background-color: rgb(25, 36, 177); color: rgb(255, 255, 255);"/>
            <ui:Button text="Black Vortex (cut, hard)" name="BlackVortexButton" class="button" style="height: auto; width: 510px; font-size: 20px; margin-top: 10px; position: relative; background-color: rgb(255, 44, 0); color: rgb(255, 255, 255);"/>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>

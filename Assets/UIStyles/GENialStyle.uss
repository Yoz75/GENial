:root {
    background-color: rgba(0, 0, 0, 0);
    -unity-slice-top: 0;
    border-top-left-radius: 0;
    border-top-right-radius: 0;
    border-bottom-right-radius: 0;
    border-bottom-left-radius: 0;
    flex-direction: column;
    flex-wrap: nowrap;
    flex-shrink: 1;
    flex-grow: 0;
    height: auto;
    aspect-ratio: auto;
    flex-basis: auto;
    border-top-color: rgb(0, 0, 0);
    border-right-color: rgb(0, 0, 0);
    border-bottom-color: rgb(0, 0, 0);
    border-left-color: rgb(0, 0, 0);
}

.panel {
    background-color: rgb(12, 12, 12);
    border-bottom-left-radius: 8px;
    border-bottom-right-radius: 8px;
    border-top-right-radius: 8px;
    border-top-left-radius: 8px;
    margin-top: 4px;
    margin-right: 4px;
    margin-bottom: 4px;
    margin-left: 4px;
    flex-direction: column;
    flex-grow: 0;
    flex-shrink: 1;
    flex-basis: 0%;
    position: relative;
    bottom: auto;
}

.button {
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    border-bottom-right-radius: 4px;
    border-bottom-left-radius: 4px;
    background-color: rgb(255, 255, 255);
    border-top-color: rgb(127, 127, 127);
    border-right-color: rgb(127, 127, 127);
    border-bottom-color: rgb(127, 127, 127);
    border-left-color: rgb(127, 127, 127);
    -unity-font-definition: url("project://database/Assets/Fonts/determination-rus-by-lyajka.otf?fileID=12800000&guid=2c083882a88b4f24a8f38ca52d1d5c8e&type=3#determination-rus-by-lyajka");
}

.label {
    color: rgb(171, 171, 171);
    -unity-font-definition: url("project://database/Assets/Fonts/determination-rus-by-lyajka.otf?fileID=12800000&guid=2c083882a88b4f24a8f38ca52d1d5c8e&type=3#determination-rus-by-lyajka");
}

.inputfield {
    color: rgb(255, 255, 255);
    -unity-font-definition: url("project://database/Assets/Fonts/determination-rus-by-lyajka.otf?fileID=12800000&guid=2c083882a88b4f24a8f38ca52d1d5c8e&type=3#determination-rus-by-lyajka");
    background-color: rgb(21, 21, 21);
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    border-bottom-right-radius: 4px;
    border-bottom-left-radius: 4px;
    -unity-text-align: middle-center;
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-top-color: rgb(32, 32, 32);
    border-right-color: rgb(32, 32, 32);
    border-bottom-color: rgb(32, 32, 32);
    border-left-color: rgb(32, 32, 32);
}

.unity-base-field__input {
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    border-bottom-right-radius: 4px;
    border-bottom-left-radius: 4px;
    background-color: rgb(32, 32, 32);
    -unity-text-align: upper-center;
}
